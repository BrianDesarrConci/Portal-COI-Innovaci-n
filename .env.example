# Puerto del API Node.js
PORT=4000
# Carpeta donde se guarda la base JSON de TRAZA (se crea sola)
DATA_DIR=./server/var

# --- Integraciones externas (se configuran en Vercel → Settings → Environment Variables) ---
# Google Sheets en vivo para COI V1 (JSON completo de la cuenta de servicio). Sin ella se usa la copia de demostración.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# n8n u otras API externas: el servidor leerá la URL base desde estas variables (no se escriben en el código).
# N8N_BASE_URL=https://<su-instancia-n8n>/webhook
# N8N_API_KEY=
