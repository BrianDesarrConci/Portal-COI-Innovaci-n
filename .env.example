# Puerto del API Node.js
PORT=4000
# Carpeta donde se guarda la base JSON de TRAZA (se crea sola)
DATA_DIR=./server/var

# --- Ingreso al portal ---
# Proveedor: "da" (API DA de Tecnología) o "demo". Si se omite, se usa DA cuando DA_BASE_URL está definida.
# AUTH_PROVEEDOR=da
# Secreto para firmar la cookie de sesión (obligatorio con DA; 32+ caracteres aleatorios, distinto por ambiente).
# COI_SESSION_SECRET=
# Duración de la sesión en minutos (por defecto 480 = 8 horas).
# COI_SESION_MINUTOS=480
# En la demo el API queda abierto; con 1 también exige sesión.
# AUTH_REQUERIDO=0
# Intentos de ingreso por IP cada 5 minutos (por defecto 10).
# AUTH_MAX_INTENTOS=10
# API DA (los valores definitivos se toman de la documentación de Tecnología).
# DA_BASE_URL=https://<api-da>
# DA_API_KEY=
# DA_API_KEY_HEADER=x-api-key
# DA_RUTA_LOGIN=/auth/login
# DA_RUTA_VERIFICAR=/auth/verificar
# Perfiles de DA → roles de COI. "admin" ve todos los módulos.
# DA_MAPA_ROLES={"ADMINISTRADOR":"admin","ANALISTA":"analista"}
# DA_TIMEOUT_MS=10000

# --- Integraciones externas (se configuran en Vercel → Settings → Environment Variables) ---
# Google Sheets en vivo para COI V1 (JSON completo de la cuenta de servicio). Sin ella se usa la copia de demostración.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# n8n u otras API externas: el servidor leerá la URL base desde estas variables (no se escriben en el código).
# N8N_BASE_URL=https://<su-instancia-n8n>/webhook
# N8N_API_KEY=

# --- Módulos de los analistas (ver docs/modulos/GUIA-ANALISTAS.md) ---
# Base MySQL del portal: todos los módulos guardan sus tablas aquí, cada uno con su prefijo (p. ej. nt_*).
# Usuario con permisos CREATE/ALTER/INDEX/SELECT/INSERT/UPDATE/DELETE/REFERENCES sobre esa base.
# COI_MYSQL_URL=mysql://usuario:clave@servidor:3306/coi
# Un módulo puede ir a otra base con su propia variable (tiene prioridad): DB_<ID>_URL=mysql://...
# Conexión cifrada (servidores en la nube): DB_SSL=1 y, si el proveedor la entrega, la CA en PEM (\n por salto de línea).
# DB_SSL=1
# DB_SSL_CA=
# Zona horaria de las sesiones y fechas (por defecto Colombia).
# DB_ZONA=-05:00
# Conexiones por pool (por defecto 5).
# DB_POOL_MAX=5
# Pruebas (npm test): MySQL donde se crean bases temporales coi_test_*; sin ella se omiten las pruebas con BD.
# COI_TEST_MYSQL_URL=mysql://coi:clave-local@127.0.0.1:3306/coi_local
# Configuración propia de un módulo: MOD_<ID>_<NOMBRE> (se lee con config.env('NOMBRE')).
